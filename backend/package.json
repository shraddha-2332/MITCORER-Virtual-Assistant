{
  "name": "mitra-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --no-warnings=ExperimentalWarning src/server.js",
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test",
    "evaluate": "node --no-warnings=ExperimentalWarning scripts/evaluate-assistant.js",
    "evaluate:public": "node --no-warnings=ExperimentalWarning scripts/evaluate-public-assistant.js",
    "evaluate:retrieval": "node --no-warnings=ExperimentalWarning scripts/compare-retrieval.js",
    "evaluate:verifiers": "node --no-warnings=ExperimentalWarning scripts/evaluate-verifiers.js",
    "evaluate:guardrails": "node --no-warnings=ExperimentalWarning scripts/evaluate-guardrails.js",
    "evaluate:document-agent": "node --no-warnings=ExperimentalWarning scripts/compare-document-agent.mjs",
    "build:developer-review-set": "python scripts/build-developer-review-cases.py",
    "evaluate:developer-review": "node --no-warnings=ExperimentalWarning scripts/run-developer-review-evaluation.mjs",
    "prepare:developer-review-pilot": "node --no-warnings=ExperimentalWarning scripts/prepare-developer-review-pilot.mjs",
    "freeze:evaluation-corpus": "node --no-warnings=ExperimentalWarning scripts/freeze-evaluation-corpus.mjs",
    "evaluate:judge": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/run-llm-judge.mjs",
    "evaluate:ragas": "python scripts/evaluate-ragas.py",
    "evaluate:load": "node --no-warnings=ExperimentalWarning scripts/evaluate-local-load.js",
    "prepare:retrieval-review": "node scripts/prepare-retrieval-review.js",
    "evaluate:paraphrases": "node --no-warnings=ExperimentalWarning scripts/evaluate-paraphrases.js",
    "check": "node --check src/server.js",
    "backup": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/backup-data.js",
    "provision:admin": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/provision-admin.js",
    "sync:website": "node --no-warnings=ExperimentalWarning scripts/sync-website.js"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
